<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="camera.App"
             xmlns:local="using:camera"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <StyleInclude Source="Styles/AppStyle.axaml"></StyleInclude>
        <FluentTheme />
    </Application.Styles>
             
    <Application.Resources>
        
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="/Controls/IconButton.axaml"></MergeResourceInclude>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
        <SolidColorBrush x:Key="PrimaryColor" Color="#0894A4"></SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryBgColor" Color="#f1f1f1"></SolidColorBrush> 
        <SolidColorBrush x:Key="PrimaryBgSidebarColor" Color="#f5f5f5"></SolidColorBrush> 
        <SolidColorBrush x:Key="PrimaryColorText" Color="#242424"></SolidColorBrush>
        
    </Application.Resources>
</Application>