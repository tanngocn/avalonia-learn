<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:camera.ViewModels"
             xmlns:local="clr-namespace:camera.Views"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:DataType="vm:LivePageViewModel"
             x:Class="camera.Views.LivePageView">
        <Design.DataContext>
            <vm:LivePageViewModel></vm:LivePageViewModel>
        </Design.DataContext>
    
        <TabControlCustom SelectionChanged="LiveTab_OnSelectionChanged" Name="LiveTabControls">
            <TabItemCustom Header="hello">
                <local:LivePrintView />
            </TabItemCustom>
            <TabItemCustom Header="hi">
                <local:LiveLogView />
            </TabItemCustom>
          
        </TabControlCustom>
</UserControl>
